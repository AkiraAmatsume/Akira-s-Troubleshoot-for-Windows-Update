  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    构建后将输出重命名为对外品牌文件名：
      Akira's Troubleshoot for Windows Update.exe
    程序集身份（AssemblyName）保持合法标识符，文件名单独控制。
  -->
  <Target Name="RenameOutputExe" AfterTargets="Build">
    <PropertyGroup>
      <__SrcExe>$(TargetPath)</__SrcExe>
      <__DstExe>$(TargetDir)Akira's Troubleshoot for Windows Update.exe</__DstExe>
    </PropertyGroup>
    <Copy SourceFiles="$(__SrcExe)" DestinationFiles="$(__DstExe)" OverwriteReadOnlyFiles="true" Condition="Exists('$(__SrcExe)')" />
    <Delete Files="$(__SrcExe)" Condition="Exists('$(__DstExe)') And !('$(__SrcExe)' == '$(__DstExe)')" />
  </Target>
</Project>
