<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    ============================================================================
    命名说明 / Naming notes
    ============================================================================
    对外产品名称 (Product name):
        Akira's Troubleshoot for Windows Update
        短名 (Short name): Akira's Troubleshoot
        Copyright 狐妖萌娘（Akira Amatsume）

    重要：Akira's Troubleshoot 是系列品牌，本工程只是其中一个子项目（专修
    Windows Update）。因此工程文件 / 命名空间仍沿用历史内部名
    "WindowsUpdateFixer"，以便未来在同一系列下扩展其它子项目时不产生歧义。

    - 物理文件名 WindowsUpdateFixer.csproj、RootNamespace=WindowsUpdateFixer
      均为内部工程标识，不对最终用户可见，保持原样。
    - AssemblyName 使用合法标识符 AkiraTroubleshootForWindowsUpdate（程序集身份）；
      生成后再由 AfterBuild 目标把产物重命名为
      "Akira's Troubleshoot for Windows Update.exe"，
      明确表示本子项目专修 Windows Update。

    Names are kept internal on purpose: the product brand "Akira's Troubleshoot"
    covers more than Windows Update; this project is only one sub-project.
    ============================================================================
  -->
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{8A3F1C2E-4D5B-4E6A-9C1D-2B3E4F5A6C7D}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <!-- 内部命名空间，保留历史名（对用户不可见）。详见文件顶部命名说明。 -->
    <RootNamespace>WindowsUpdateFixer</RootNamespace>
    <!-- 程序集标识名（必须是合法标识符，不能含空格/撇号）。
         最终 exe 文件名由下方 AfterBuild 目标重命名为
         "Akira's Troubleshoot for Windows Update.exe"（详见文件顶部命名说明）。 -->
    <AssemblyName>AkiraTroubleshootForWindowsUpdate</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <!--
      架构固定为 x86，请勿改为 AnyCPU / x64。
      理由与约束见 code/DESIGN-NOTES.txt。
      注意：Platform 为 AnyCPU 时若缺少 PlatformTarget，产物在 64 位系统上会以
      x64 运行，从而绕过本工具赖以成立的前提；因此必须显式声明 x86，并关闭
      Prefer32Bit（Prefer32Bit 仅对 AnyCPU 生效，此处显式关闭以防后续误改）。
    -->
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ProjectTypeGuids>{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <WarningLevel>4</WarningLevel>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <LangVersion>5</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
