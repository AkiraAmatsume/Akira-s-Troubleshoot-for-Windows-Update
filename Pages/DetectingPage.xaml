<UserControl x:Class="WindowsUpdateFixer.Pages.DetectingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 检测卡片模板 -->
        <DataTemplate x:Key="CheckCard">
            <Border Background="{StaticResource SurfaceContainerBrush}" CornerRadius="14"
                    Padding="16,14" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SeverityGlyph}" FontFamily="Segoe MDL2 Assets"
                               FontSize="18" Margin="0,2,14,0" VerticalAlignment="Top"
                               Foreground="{Binding SeverityBrush, Converter={StaticResource BrushConverter}}" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Md3Title}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Md3Body}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Md3Label}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText" Text="正在检测系统更新组件"
                       Style="{StaticResource Md3Headline}" />
            <TextBlock x:Name="CurrentText" Text="准备中…"
                       Style="{StaticResource Md3Body}" Margin="0,8,0,12" />
            <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True"
                         Foreground="{StaticResource PrimaryBrush}" BorderThickness="0" />
        </StackPanel>

        <!-- 卡片列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <ItemsControl x:Name="CheckList" ItemTemplate="{StaticResource CheckCard}" />
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,20">
            <Button x:Name="CloseButton" Content="关闭" Style="{StaticResource Md3OutlinedButton}"
                    Margin="0,0,12,0" Visibility="Collapsed" Click="Close_Click" />
            <Button x:Name="RepairButton" Content="开始修复" Style="{StaticResource Md3FilledButton}"
                    Visibility="Collapsed" Click="Repair_Click" />
        </StackPanel>
    </Grid>
</UserControl>

