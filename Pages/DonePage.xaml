<UserControl x:Class="WindowsUpdateFixer.Pages.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 已完成卡片 -->
        <DataTemplate x:Key="FixedCard">
            <Border Background="{StaticResource SurfaceContainerBrush}" CornerRadius="14"
                    Padding="16,14" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Margin="0,2,14,0" VerticalAlignment="Top"
                               Foreground="{StaticResource SuccessBrush}" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Md3Title}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Md3Body}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 手动处理卡片 -->
        <DataTemplate x:Key="ManualCard">
            <Border Background="{StaticResource WarningContainerBrush}" CornerRadius="14"
                    Padding="16,14" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Margin="0,2,14,0" VerticalAlignment="Top"
                               Foreground="{StaticResource WarningBrush}" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Md3Title}" />
                        <TextBlock Style="{StaticResource Md3Body}" Margin="0,4,0,0"
                                   Text="{Binding ManualHint}" />

                        <!-- 修复阶段确认的具体后续建议（如 DISM / SFC 命令），无则不占位 -->
                        <TextBlock Style="{StaticResource Md3Body}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Text="{Binding FollowUpHint}"
                                   FontFamily="Consolas, Microsoft YaHei UI"
                                   Visibility="{Binding HasFollowUpHint,
                                       Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 顶部图标 -->
                <Border x:Name="ResultIconBox" Width="64" Height="64" CornerRadius="32"
                        HorizontalAlignment="Left" Background="{StaticResource SuccessContainerBrush}">
                    <TextBlock x:Name="ResultGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="30" Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="TitleText" Text="修复完成"
                           Style="{StaticResource Md3Headline}" Margin="0,20,0,0" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Md3Body}" Margin="0,8,0,0" />

                <!-- 收尾步骤（gpupdate）失败时的补充提示，默认隐藏 -->
                <Border x:Name="GroupPolicyHintBox" Margin="0,16,0,0"
                        Background="{StaticResource WarningContainerBrush}" CornerRadius="12"
                        Padding="14,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock x:Name="GroupPolicyHint" MaxWidth="420"
                                   Style="{StaticResource Md3Label}" FontSize="13"
                                   Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                </Border>

                <!-- 分组1：已完成的修复 -->
                <StackPanel x:Name="FixedGroup" Margin="0,24,0,0">
                    <TextBlock Text="已完成的修复" Style="{StaticResource Md3Title}" Margin="0,0,0,12" />
                    <ItemsControl x:Name="FixedList" ItemTemplate="{StaticResource FixedCard}" />
                </StackPanel>

                <!-- 分组2：需要手动处理 -->
                <StackPanel x:Name="ManualGroup" Margin="0,24,0,0" Visibility="Collapsed">
                    <TextBlock Text="需要手动处理" Style="{StaticResource Md3Title}" Margin="0,0,0,12" />
                    <ItemsControl x:Name="ManualList" ItemTemplate="{StaticResource ManualCard}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,20">
            <Button Content="稍后重启" Style="{StaticResource Md3OutlinedButton}"
                    Margin="0,0,12,0" Click="Later_Click" />
            <Button Content="立即重启" Style="{StaticResource Md3FilledButton}"
                    Click="Reboot_Click" />
        </StackPanel>
    </Grid>
</UserControl>

