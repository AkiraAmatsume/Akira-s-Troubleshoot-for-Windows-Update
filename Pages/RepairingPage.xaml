<UserControl x:Class="WindowsUpdateFixer.Pages.RepairingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="RepairCard">
            <Border Background="{StaticResource SurfaceContainerBrush}" CornerRadius="14"
                    Padding="16,14" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StateGlyph}" FontFamily="Segoe MDL2 Assets"
                               FontSize="18" Margin="0,2,14,0" VerticalAlignment="Top"
                               Foreground="{Binding StateBrush, Converter={StaticResource BrushConverter}}" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Md3Title}" />
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Md3Label}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="正在修复" Style="{StaticResource Md3Headline}" />
            <TextBlock x:Name="CurrentText" Text="准备中…"
                       Style="{StaticResource Md3Body}" Margin="0,8,0,12" />
            <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True"
                         Foreground="{StaticResource PrimaryBrush}" BorderThickness="0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,20">
            <ItemsControl x:Name="RepairList" ItemTemplate="{StaticResource RepairCard}" />
        </ScrollViewer>
    </Grid>
</UserControl>

